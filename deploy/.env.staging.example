# Copy to deploy/.env.staging and fill real values. Do NOT commit deploy/.env.staging.
# Used by deploy/docker-compose.staging.yml (SQL Server + Loyalty microservice).
# ASP.NET Core binds nested config with double underscores (ConnectionStrings__LoyaltyDb).
# See deploy/SECRETS_AND_ENV.md and README.md (Configuration and environments).

ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=http://+:8080
Kestrel__GrpcHttp2Port=8081

MSSQL_SA_PASSWORD=CHANGE_ME
ConnectionStrings__LoyaltyDb=Server=sqlserver;Database=LoyaltyHub_Loyalty_Staging;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=False

AppSettings__Version=S
AppSettings__Environment=Staging
AppSettings__IsSwaggerActivated=true
AppSettings__IsSeedDataActivated=false
AppSettings__IsGrpcReflectionActivated=true
