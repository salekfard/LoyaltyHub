## Visual Studio / .NET — based on github/gitignore VisualStudio.gitignore

## Ignore Mac DS_Store files
.DS_Store

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
out/
[Aa]rtifacts/

# Visual Studio cache/options
.vs/
Generated\ Files/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
TestResults/
coverage*/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Benchmark Results
BenchmarkDotNet.Artifacts/

# .NET Core / NuGet
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
!Directory.Build.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc
*.binlog

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Visual Studio profiler / trace
*.psess
*.vsp
*.vspx
*.sap
*.e2e

# ReSharper / Rider / JetBrains
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/
*.sln.iml

# DotCover / Coverlet / OpenCover
*.dotCover
.axoCover/*
!.axoCover/settings.json
OpenCover/

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# Publish / Click-Once
publish/
**/publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.pubxml.user
*.publishproj
PublishScripts/

# Azure
csx/
*.build.csdef
ecf/
rcf/

# Windows Store
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload

# Cache files
*.[Cc]ache
!?*.[Cc]ache/

# Others
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.key
*.publishsettings
orleans.codegen.cs

# SQL Server files
*.mdf
*.ldf
*.ndf

# Upgrade / backup
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak
MigrationBackup/
.localhistory/
.vshistory/

# Node (if any tooling uses it)
node_modules/
.ntvs_analysis.dat

# Python (local helpers)
__pycache__/
*.pyc

# Fody
FodyWeavers.xsd

# VS Code — keep shared workspace files when present
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Windows Installer / OS junk
*.cab
*.msi
*.msix
*.msm
*.msp
Thumbs.db
ehthumbs.db
Desktop.ini

# Secrets and local environment
.env
.env.*
!.env.example
!.env.*.example
!deploy/.env.*.example
.env.staging
.env.production
deploy/.env.staging
deploy/.env.production
**/appsettings.*.local.json
**/secrets.json
**/Secrets/

# EF temporary
**/Migrations/*.Designer.cs.bak
